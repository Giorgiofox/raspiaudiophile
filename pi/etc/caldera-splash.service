[Unit]
Description=Show splash on the TFT as soon as its framebuffer appears
DefaultDependencies=no
After=systemd-udev-trigger.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c "for i in $(seq 1 100); do for f in /sys/class/graphics/fb*; do if grep -q ili9481 $f/name 2>/dev/null; then cat /boot/firmware/splash.raw > /dev/$(basename $f); exit 0; fi; done; sleep 0.2; done"

[Install]
WantedBy=sysinit.target
