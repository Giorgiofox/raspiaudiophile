[Unit]
Description=Release fb0 from the kernel console so the splash and panel own it
DefaultDependencies=no
After=caldera-splash.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c "for v in /sys/class/vtconsole/vtcon*; do grep -q \"frame buffer\" $v/name && echo 0 > $v/bind || true; done"

[Install]
WantedBy=sysinit.target
