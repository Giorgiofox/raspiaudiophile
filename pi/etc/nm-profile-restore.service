[Unit]
Description=Restore Wi-Fi profile if fsck orphan-cleanup destroyed it
Before=NetworkManager.service
ConditionPathExists=!/etc/NetworkManager/system-connections/GiorgioFoX.nmconnection

[Service]
Type=oneshot
ExecStart=/bin/cp -p /usr/local/share/caldera/wifi-backup/GiorgioFoX.nmconnection /etc/NetworkManager/system-connections/
ExecStartPost=/bin/chmod 600 /etc/NetworkManager/system-connections/GiorgioFoX.nmconnection

[Install]
WantedBy=multi-user.target
