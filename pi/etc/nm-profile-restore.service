[Unit]
Description=Restore Wi-Fi profiles if fsck orphan-cleanup destroyed them
Before=NetworkManager.service
ConditionDirectoryNotEmpty=!/etc/NetworkManager/system-connections

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'cp -p /usr/local/share/caldera/wifi-backup/*.nmconnection /etc/NetworkManager/system-connections/ 2>/dev/null; chmod 600 /etc/NetworkManager/system-connections/*.nmconnection 2>/dev/null; true'

[Install]
WantedBy=multi-user.target
